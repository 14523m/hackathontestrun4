# Copy to mobile/.env — used when building / running the app.
# iOS simulator default works out of the box (localhost:8000).

# For a PHYSICAL phone, set your Mac's LAN IP (System Settings → Wi-Fi → Details):
#   e.g. EXPO_PUBLIC_API_URL=http://10.89.63.154:8000
# The phone must be able to reach it: same network WITHOUT client isolation,
# or use a personal hotspot. Backend must run with: --host 0.0.0.0
EXPO_PUBLIC_API_URL=http://localhost:8000
