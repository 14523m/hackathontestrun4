# HK CoolPath AI - backend configuration
# Copy to backend/.env (or export) and adjust. See docs/development.md.

# demo = deterministic simulation (offline-safe, default)
# live = fetch HKO Open Data observations (falls back to last valid obs, flagged STALE)
DATA_MODE=demo

# HKO Open Data endpoint
HKO_BASE_URL=https://data.weather.gov.hk/weatherAPI/opendata/weather.php

# Weather cache / staleness
WEATHER_CACHE_SECONDS=600
WEATHER_STALE_AFTER_SECONDS=21600

# Prototype heat-model calibration (documented in docs/architecture.md)
HEAT_SOLAR_WEIGHT=7.0
HEAT_SHADE_WEIGHT=7.0
HEAT_VEGETATION_WEIGHT=5.5
HEAT_SURFACE_TEMPERATURE_WEIGHT=4.0
HEAT_WIND_WEIGHT=2.5
HEAT_HUMIDITY_WEIGHT=2.0
HEAT_BUILDING_DENSITY_WEIGHT=2.2

# Prototype route-mode weights (alpha=time, beta=heat, gamma=slope)
ROUTE_FASTEST_ALPHA=1.0
ROUTE_FASTEST_BETA=0.05
ROUTE_BALANCED_ALPHA=0.6
ROUTE_BALANCED_BETA=1.0
ROUTE_COOLEST_ALPHA=0.15
ROUTE_COOLEST_BETA=2.5
